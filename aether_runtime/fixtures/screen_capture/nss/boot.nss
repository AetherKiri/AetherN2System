chapter main
{
    CreateColor("background", 1, 0, 0, 320, 180, "RED");
    CreateColor("corner", 2, 160, 90, 160, 90, "BLUE");
    WaitKey();
    LoadImage("screen_image", SCREEN);
    LoadImage("video_image", VIDEO);
    Delete("background");
    Delete("corner");
    CreateColor("background", 1, 0, 0, 320, 180, "GREEN");
    WaitKey();
    CreateTexture("screen_copy", 2, 0, 0, "screen_image");
    Delete("screen_image");
    WaitKey();
    Delete("screen_copy");
    CreateTexture("video_copy", 2, 0, 0, "video_image");
    Delete("video_image");
    WaitKey();
    Delete("video_copy");
    CreateTexture("direct_screen", 2, 0, 0, SCREEN);
    WaitKey();
    Delete("direct_screen");
    CreateTexture("direct_video", 2, 0, 0, VIDEO);
    WaitKey();
    LoadImage("crop_image", SCREEN);
    Delete("direct_video");
    CreateClipTexture("cropped", 2, 0, 0, 160, 90, 160, 90, "crop_image");
    Delete("crop_image");
    WaitKey();
    Delete("cropped");
    WaitKey();
    CreateColor("passive_background", 2, 0, 0, 320, 180, "RED");
    CreateColor("passive_corner", 3, 160, 90, 160, 90, "BLUE");
    WaitKey();
    CreateEffect("plain", 4, 0, 0, 320, 180, "Plain");
    Request("plain", Passive);
    Request("plain", Lock);
    Delete("plain");
    Delete("passive_background");
    Delete("passive_corner");
    WaitKey();
    Request("plain", UnLock);
    Delete("plain");
    WaitKey();
    CreateColor("passive_background", 2, 0, 0, 320, 180, "RED");
    CreateColor("passive_corner", 3, 160, 90, 160, 90, "BLUE");
    WaitKey();
    CreateEffect("plain_crop", 4, 160, 90, 160, 90, "Plain");
    Request("plain_crop", "Passive");
    Delete("passive_background");
    Delete("passive_corner");
    Move("plain_crop", 0, 0, 0);
    WaitKey();
    Move("plain_crop", 0, 160, 90);
    Fade("plain_crop", 0, 500, 0);
    WaitKey();
    Delete("plain_crop");
    WaitKey();
    Exit();
}
