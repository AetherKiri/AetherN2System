<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aether_n2system</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsAndroid)' == 'true' Or '$(IsIOS)' == 'true'">
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsIOS)' == 'true'">
    <NativeLib>Static</NativeLib>
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsIOS)' == 'true'">
    <DirectPInvoke Include="libfreetype;libopenal;libavcodec.62;libavformat.62;libavutil.60;libswresample.6;libswscale.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsAndroid)' == 'true' Or '$(IsIOS)' == 'true'">
    <EmbeddedResource Include="../fonts/*.ttf" LogicalName="AetherN2System.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AetherRuntimeCjkFontPath)" Condition="'$(AetherRuntimeCjkFontPath)' != ''" LogicalName="AetherN2System.Fonts.aetherkiri-runtime-cjk.otf" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <ProjectReference Include="../src/NitroSharp.Rebuild/NitroSharp.Rebuild.csproj" />
  </ItemGroup>
</Project>
